    "def quarto_side_local(quarto_size, side_index):\n",
    "    \"\"\"Local 1-based page numbers for one side of quarto.\n",
    "    quarto_size must be a multiple of 4.\"\"\"\n",
    "    k = side_index // 2\n",
    "    if side_index % 2 == 0:                 # front of sheet k\n",
    "        return (quarto_size - 4*k, 1 + 4*k,\n",
    "                quarto_size - 4*k - 2, 3 + 4*k)\n",
    "    else:                                   # back of sheet k\n",
    "        return (2 + 4*k, quarto_size - 4*k - 1,\n",
    "                4 + 4*k, quarto_size - 4*k - 3)\n",
    "\n",
    "\n",
    "def quarto_imposition(n, sig_size=20):\n",
    "    \"\"\"List of (front, back) 4-tuples, one per physical sheet.\n",
    "\n",
    "    Sides are paired *within* each signature. If a signature ends on an odd\n",
    "    side, that leftover side is merged with the next signature's first side:\n",
    "    top rows on the front, bottom rows on the back. No padding between\n",
    "    signatures; only a truly orphan final side gets an empty back.\n",
    "    \"\"\"\n",
    "    sigs = []\n",
    "    start = 1\n",
    "    while start <= n:\n",
    "        size = min(sig_size, n - start + 1)\n",
    "        if size % 4 == 0 and size >= 8:\n",
    "            quarto_size = size\n",
    "        else:\n",
    "            quarto_size = (size // 8) * 8\n",
    "        extra = size - quarto_size\n",
    "\n",
    "        sides = []\n",
    "        if quarto_size:\n",
    "            for i in range(quarto_size // 4):\n",
    "                loc = quarto_side_local(quarto_size, i)\n",
    "                sides.append(tuple(\n",
    "                    start + l - 1 if 1 <= l <= quarto_size else 0\n",
    "                    for l in loc))\n",
    "\n",
    "        if extra:                                       # remainder pages\n",
    "            base = start + quarto_size\n",
    "            i = 0\n",
    "            while i < extra:\n",
    "                chunk = min(4, extra - i)\n",
    "                sides.append(tuple(\n",
    "                    base + i + j if j < chunk else 0 for j in range(4)))\n",
    "                i += 4\n",
    "\n",
    "        sigs.append(sides)\n",
    "        start += size\n",
    "\n",
    "    sheets, carry = [], None\n",
    "    for sides in sigs:\n",
    "        idx = 0\n",
    "        if carry is not None and idx < len(sides):\n",
    "            b = sides[idx]\n",
    "            sheets.append(((carry[0], carry[1], b[0], b[1]),\n",
    "                           (carry[2], carry[3], b[2], b[3])))\n",
    "            carry = None\n",
    "            idx += 1\n",
    "        while idx + 1 < len(sides):\n",
    "            sheets.append((sides[idx], sides[idx + 1]))\n",
    "            idx += 2\n",
    "        if idx < len(sides):\n",
    "            carry = sides[idx]\n",
    "    if carry is not None:\n",
    "        sheets.append((carry, (0, 0, 0, 0)))\n",
    "    return sheets"
   ]
